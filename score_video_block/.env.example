# Model artifacts (relative paths resolve from the repository root).
PICKLEBALL_CHECKPOINT=src/weights/best.pt
PICKLEBALL_BEATS_CHECKPOINT=src/weights/BEATs_iter3_plus_AS2M.pt
PICKLEBALL_BEATS_ROOT=vendor/unilm
PICKLEBALL_VIDEOMAE=src/weights/videomae-base
# Missing VideoMAE files are downloaded from this Hub repo at startup; empty = offline.
PICKLEBALL_VIDEOMAE_REPO=MCG-NJU/videomae-base
# auto | cpu | cuda
PICKLEBALL_DEVICE=auto
# Windows per forward pass (0 = 16 on CUDA, 4 on CPU); VideoMAE precision
# auto | fp32 | fp16 | bf16 (auto = fp16 on CUDA); GPU frame preprocessing.
PICKLEBALL_BATCH_SIZE=0
PICKLEBALL_PRECISION=auto
PICKLEBALL_GPU_PREPROCESS=false
# Exact frame preprocessing processes (needs /dev/shm; Docker: --shm-size=1g); 0 = threads.
PICKLEBALL_PREPROCESS_WORKERS=8
PICKLEBALL_MAX_VIDEO_BYTES=536870912
# Concurrency: videos analysed at once (each slot has its own preprocessing workers),
# requests accepted at once (more get 429 + Retry-After), parallel download parts,
# seconds a completed result is kept for client retries of the same job_id.
PICKLEBALL_INFERENCE_SLOTS=2
PICKLEBALL_MAX_PENDING_JOBS=8
PICKLEBALL_BUSY_RETRY_AFTER_SECONDS=10
PICKLEBALL_DOWNLOAD_PARTS=4
PICKLEBALL_RESULT_CACHE_SECONDS=600

# Inference hyperparameters (defaults live in src/pickleball_track/core/config.py).
# Uncomment to override:
# PICKLEBALL_HIT_THRESHOLD=0.8
# PICKLEBALL_MISS_THRESHOLD=0.8
# PICKLEBALL_EVENT_MIN_GAP=0.5
# PICKLEBALL_SMOOTH_RADIUS=1
# PICKLEBALL_OVERLAP=0.5

# MinIO credentials: set real values only in the deployment environment.
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_SECURE=false
# Optional: always download from this endpoint, ignoring the request's minio_endpoint
# (use when the backend sends a host name only resolvable on its own network).
MINIO_PUBLIC_ENDPOINT=

LOG_LEVEL=INFO
