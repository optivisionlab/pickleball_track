# Model artifacts (relative paths resolve from the repository root).
PICKLEBALL_CHECKPOINT=src/weights/best.pt
PICKLEBALL_BEATS_CHECKPOINT=src/weights/BEATs_iter3_plus_AS2M.pt
PICKLEBALL_BEATS_ROOT=vendor/unilm
PICKLEBALL_VIDEOMAE=src/weights/videomae-base
# auto | cpu | cuda
PICKLEBALL_DEVICE=auto
PICKLEBALL_MAX_VIDEO_BYTES=536870912

# Inference hyperparameters (defaults live in src/pickleball_track/core/config.py).
# Uncomment to override:
# PICKLEBALL_HIT_THRESHOLD=0.8
# PICKLEBALL_MISS_THRESHOLD=0.8
# PICKLEBALL_EVENT_MIN_GAP=0.5
# PICKLEBALL_SMOOTH_RADIUS=1
# PICKLEBALL_OVERLAP=0.5

# MinIO credentials: set real values only in the deployment environment.
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_SECURE=false

LOG_LEVEL=INFO
