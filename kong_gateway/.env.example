# ==========================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG KONG HYBRID GATEWAY
# ==========================================

# 1. Cấu hình Database PostgreSQL (Cho Control Plane)
POSTGRES_DB=kong
POSTGRES_USER=kong
POSTGRES_PASSWORD=kongpass_secure_local
POSTGRES_PORT=5432

# 2. Cấu hình Kong Image & Network
KONG_IMAGE=kong:3.8
KONG_DATABASE=postgres

# 3. Cấu hình Kong Control Plane (CP)
KONG_CP_ADMIN_PORT=8001
KONG_CP_GUI_PORT=8002
KONG_CP_CLUSTER_PORT=8005
KONG_CP_TELEMETRY_PORT=8006

# URL của Kong Manager (Web UI)
KONG_ADMIN_GUI_URL=http://localhost:8002

# 4. Cấu hình Kong Data Plane (DP)
KONG_DP_PROXY_PORT=8000
KONG_DP_PROXY_SSL_PORT=8443

# 5. Cấu hình Cluster mTLS Certs
KONG_CLUSTER_CERT=/etc/kong/certs/cluster.crt
KONG_CLUSTER_CERT_KEY=/etc/kong/certs/cluster.key
